import pandas as pd
from datetime import datetime
from typing import List, Dict, Any, Optional, Union
from sqlalchemy.orm import Session

from app.db.models import DecisionScenario, BusinessGoal, BusinessAlert, DecisionHistory, Dataset, DataRecord, ForecastModel, AnomalyResult
from app.schemas.schemas import (
    WhatIfScenario, HealthScore, BusinessRecommendation,
    GoalPlannerRequest, GoalPlannerResponse, RootCauseAnalysis,
    BusinessAlert as BusinessAlertSchema, ExecutiveAdvisorRequest, ExecutiveAdvisorResponse
)

# Column Aliases for Dynamic Detection
REVENUE_ALIASES = ["revenue", "sales", "total sales", "amount", "price", "turnover", "total_sales", "income", "sales_amount"]
PROFIT_ALIASES = ["profit", "net profit", "gross profit", "net_profit", "gross_profit", "earnings", "margin"]
ORDERS_ALIASES = ["orders", "order count", "transactions", "order_count", "quantity", "qty", "orders_count", "sales_count"]
CUSTOMERS_ALIASES = ["customers", "customer count", "clients", "customer_count", "client_count", "users", "customer_name", "customer", "client_name"]
REGION_ALIASES = ["region", "state", "territory", "country", "location", "zone", "area"]
CATEGORY_ALIASES = ["category", "product category", "product_category", "group", "type", "class", "product_type"]

class DecisionIntelligenceService:

    @staticmethod
    def _detect_column(df: pd.DataFrame, aliases: List[str]) -> Optional[str]:
        """
        Dynamically detects equivalent columns in the DataFrame using case-insensitive matches.
        """
        cols = [str(c).lower().strip() for c in df.columns]
        # Try exact matching first
        for alias in aliases:
            alias_norm = alias.lower().strip()
            if alias_norm in cols:
                idx = cols.index(alias_norm)
                return df.columns[idx]
        # Try substring matching
        for alias in aliases:
            alias_norm = alias.lower().strip()
            for idx, col in enumerate(cols):
                if alias_norm in col or col in alias_norm:
                    return df.columns[idx]
        return None

    @classmethod
    def _get_dataset_df(cls, db: Session, dataset_id: Optional[int] = None) -> tuple[Optional[Dataset], Optional[pd.DataFrame]]:
        """
        Retrieves the specified dataset and loads its DataRecords into a pandas DataFrame.
        If no datasets exist, returns (None, None).
        """
        # Find dataset
        if dataset_id:
            ds = db.query(Dataset).filter(Dataset.id == dataset_id).first()
        else:
            ds = db.query(Dataset).order_by(Dataset.created_at.desc()).first()

        if not ds:
            return None, None

        records = db.query(DataRecord).filter(DataRecord.dataset_id == ds.id).all()
        if not records:
            return ds, None

        df = pd.DataFrame([r.payload for r in records])
        return ds, df

    @classmethod
    def get_health_score(cls, db: Session, user_id: int, dataset_id: Optional[int] = None) -> Union[HealthScore, Dict[str, Any]]:
        ds, df = cls._get_dataset_df(db, dataset_id)
        if ds is None or df is None:
            return {
                "success": True,
                "data": None,
                "message": "No datasets uploaded."
            }

        # Detect columns
        rev_col = cls._detect_column(df, REVENUE_ALIASES)
        profit_col = cls._detect_column(df, PROFIT_ALIASES)
        orders_col = cls._detect_column(df, ORDERS_ALIASES)
        cust_col = cls._detect_column(df, CUSTOMERS_ALIASES)

        # 1. Revenue Score
        rev_score = 0.0
        if rev_col and rev_col in df.columns:
            df[rev_col] = pd.to_numeric(df[rev_col], errors='coerce').fillna(0.0)
            if df[rev_col].sum() > 0:
                rev_score = min(float((df[rev_col] > 0).mean() * 100.0), 100.0)

        # 2. Profit Score
        profit_score = 0.0
        if profit_col and profit_col in df.columns:
            df[profit_col] = pd.to_numeric(df[profit_col], errors='coerce').fillna(0.0)
            if df[profit_col].sum() > 0:
                profit_score = min(float((df[profit_col] > 0).mean() * 100.0), 100.0)

        # 3. Sales Score
        sales_score = 0.0
        if orders_col and orders_col in df.columns:
            df[orders_col] = pd.to_numeric(df[orders_col], errors='coerce').fillna(0.0)
            if df[orders_col].sum() > 0:
                sales_score = min(float((df[orders_col] > 0).mean() * 100.0), 100.0)

        # 4. Customers Score
        cust_score = 0.0
        if cust_col and cust_col in df.columns:
            unique_cust = df[cust_col].nunique()
            cust_score = min(float(unique_cust * 2.0), 100.0)

        # 5. Forecast Confidence Score
        forecast_score = 0.0
        fm = db.query(ForecastModel).filter(ForecastModel.dataset_id == ds.id).first()
        if fm and fm.metrics_json:
            r2 = fm.metrics_json.get("r2_score", 0.0)
            forecast_score = max(min(float(r2 * 100.0), 100.0), 0.0)

        # 6. Operational Risk Score
        anomalies = db.query(AnomalyResult).filter(AnomalyResult.dataset_id == ds.id).all()
        op_risk = max(100.0 - (len(anomalies) * 10.0), 0.0)

        # 7. Data Quality Score
        quality_score = float(ds.quality_score) if ds.quality_score is not None else 100.0

        # Overall Score
        scores_list = [rev_score, profit_score, sales_score, cust_score, forecast_score, op_risk, quality_score]
        valid_scores = [s for s in scores_list if s > 0]
        overall = sum(valid_scores) / len(valid_scores) if valid_scores else 0.0

        status_label = "Critical"
        if overall >= 80.0:
            status_label = "Good"
        elif overall >= 60.0:
            status_label = "Warning"

        trend = "Stable"
        if overall > 75.0:
            trend = "Up"
        elif overall < 50.0:
            trend = "Down"

        return HealthScore(
            score=round(overall, 2),
            breakdown={
                "Revenue": round(rev_score, 2),
                "Profit": round(profit_score, 2),
                "Sales": round(sales_score, 2),
                "Customers": round(cust_score, 2),
                "Forecast Confidence": round(forecast_score, 2),
                "Operational Risk": round(op_risk, 2),
                "Data Quality": round(quality_score, 2)
            },
            status=status_label,
            trend=trend,
            calculated_at=datetime.utcnow()
        )

    @classmethod
    def run_what_if_analysis(cls, db: Session, user_id: int, scenario: WhatIfScenario) -> Union[WhatIfScenario, Dict[str, Any]]:
        # Load dataset
        ds, df = cls._get_dataset_df(db)
        if ds is None or df is None:
            return {
                "success": True,
                "data": None,
                "message": "No datasets uploaded."
            }

        # Detect columns
        rev_col = cls._detect_column(df, REVENUE_ALIASES)
        profit_col = cls._detect_column(df, PROFIT_ALIASES)

        base_revenue = 0.0
        base_profit = 0.0

        if rev_col and rev_col in df.columns:
            df[rev_col] = pd.to_numeric(df[rev_col], errors='coerce').fillna(0.0)
            base_revenue = float(df[rev_col].sum())
        if profit_col and profit_col in df.columns:
            df[profit_col] = pd.to_numeric(df[profit_col], errors='coerce').fillna(0.0)
            base_profit = float(df[profit_col].sum())

        variables = scenario.variables or {}
        price_change = float(variables.get("price_change_pct", 0.0))
        volume_change = float(variables.get("volume_change_pct", 0.0))

        projected_rev = base_revenue * (1.0 + price_change) * (1.0 + volume_change)
        projected_profit = base_profit * (1.0 + price_change * 1.5) * (1.0 + volume_change * 0.8)

        projected = {
            "base_revenue": round(base_revenue, 2),
            "base_profit": round(base_profit, 2),
            "projected_revenue": round(projected_rev, 2),
            "projected_profit": round(projected_profit, 2),
            "projected_margin_pct": round((projected_profit / projected_rev * 100.0), 2) if projected_rev > 0 else 0.0
        }

        db_scenario = DecisionScenario(
            user_id=user_id,
            name=scenario.name,
            description=scenario.description,
            variables_json=variables,
            projected_metrics_json=projected
        )
        db.add(db_scenario)
        db.commit()
        db.refresh(db_scenario)

        return WhatIfScenario(
            id=db_scenario.id,
            name=db_scenario.name,
            description=db_scenario.description,
            variables=db_scenario.variables_json,
            projected_metrics=db_scenario.projected_metrics_json,
            created_at=db_scenario.created_at
        )

    @classmethod
    def get_root_cause_analysis(cls, db: Session, user_id: int, dataset_id: Optional[int] = None, metric: Optional[str] = None) -> Union[RootCauseAnalysis, Dict[str, Any]]:
        ds, df = cls._get_dataset_df(db, dataset_id)
        if ds is None or df is None:
            return {
                "success": True,
                "data": None,
                "message": "No datasets uploaded."
            }

        target_metric = metric or "Revenue"
        deviation_pct = 0.0
        causes = []
        insights = []

        # Find column matching target metric
        col_aliases = REVENUE_ALIASES if target_metric.lower() in ["revenue", "sales"] else PROFIT_ALIASES
        matched_col = cls._detect_column(df, col_aliases)

        if matched_col and matched_col in df.columns:
            df[matched_col] = pd.to_numeric(df[matched_col], errors='coerce').fillna(0.0)
            # Find deviation from mean (mocking root cause analysis logically from dataset variance)
            std_dev = df[matched_col].std()
            mean_val = df[matched_col].mean()
            if mean_val > 0:
                deviation_pct = round(float((std_dev / mean_val) * -10.0), 2)

            causes = [
                {"factor": f"High variance in {matched_col}", "contribution_pct": 55.0},
                {"factor": "Outliers and transaction anomalies", "contribution_pct": 45.0}
            ]
            insights = [
                f"Statistical root cause highlights variance in {matched_col} as the main driver of overall deviation.",
                "Consolidate anomalous spikes to lower variance."
            ]

        return RootCauseAnalysis(
            metric=target_metric,
            deviation_pct=deviation_pct,
            possible_causes=causes,
            insights=insights,
            analyzed_at=datetime.utcnow()
        )

    @classmethod
    def plan_goal(cls, db: Session, user_id: int, req: GoalPlannerRequest) -> Union[GoalPlannerResponse, Dict[str, Any]]:
        ds, df = cls._get_dataset_df(db)
        if ds is None or df is None:
            return {
                "success": True,
                "data": None,
                "message": "No datasets uploaded."
            }

        # Save goal to DB
        db_goal = BusinessGoal(
            user_id=user_id,
            metric_name=req.metric_name,
            target_value=req.target_value,
            current_value=req.current_value,
            target_date=req.target_date,
            status="active"
        )
        db.add(db_goal)
        db.commit()
        db.refresh(db_goal)

        diff = req.target_value - req.current_value
        success = diff >= 0
        steps = []
        feasibility = 0.0

        if success:
            step_size = diff / 3.0
            steps = [
                {"step": 1, "description": f"Increase baseline {req.metric_name} by {round(step_size, 2)}.", "target_subvalue": round(req.current_value + step_size, 2)},
                {"step": 2, "description": f"Optimize cost structures to boost net {req.metric_name} by {round(step_size * 2, 2)}.", "target_subvalue": round(req.current_value + step_size * 2, 2)},
                {"step": 3, "description": f"Achieve goal target value of {req.target_value}.", "target_subvalue": req.target_value}
            ]
            feasibility = 80.0
        else:
            steps = [{"step": 1, "description": "Goal target value is less than or equal to current value. Alignment achieved.", "target_subvalue": req.target_value}]
            feasibility = 100.0

        return GoalPlannerResponse(
            success=success,
            plan_steps=steps,
            feasibility_score=feasibility,
            estimated_completion_date=req.target_date,
            recommendations=[
                f"Expand sales pipelines for {req.metric_name} scaling.",
                "Review channel performance quarterly to address variance."
            ]
        )

    @classmethod
    def get_recommendations(cls, db: Session, user_id: int, dataset_id: Optional[int] = None) -> Union[List[BusinessRecommendation], Dict[str, Any]]:
        ds, df = cls._get_dataset_df(db, dataset_id)
        if ds is None or df is None:
            return {
                "success": True,
                "data": None,
                "message": "No datasets uploaded."
            }

        recommendations = []
        # Create standard recommendation calculated from dataset quality/size
        quality_score = float(ds.quality_score) if ds.quality_score is not None else 100.0

        recommendations.append(
            BusinessRecommendation(
                title="Optimize Resource Allocation",
                description=f"Analysis of dataset '{ds.name}' (containing {len(df)} rows) suggests consolidations to optimize top-line performance.",
                impact_score=85.0,
                difficulty="Medium",
                category="cost",
                created_at=datetime.utcnow()
            )
        )
        recommendations.append(
            BusinessRecommendation(
                title="Data Quality Remediation",
                description=f"Dataset quality is scored at {quality_score}%. Resolve missing values to increase forecast confidence.",
                impact_score=90.0,
                difficulty="Easy",
                category="customer",
                created_at=datetime.utcnow()
            )
        )
        return recommendations

    @classmethod
    def get_alerts(cls, db: Session, user_id: int, dataset_id: Optional[int] = None) -> Union[List[BusinessAlertSchema], Dict[str, Any]]:
        ds, df = cls._get_dataset_df(db, dataset_id)
        if ds is None or df is None:
            return {
                "success": True,
                "data": None,
                "message": "No datasets uploaded."
            }

        # Check alerts from DB
        db_alerts = db.query(BusinessAlert).filter(BusinessAlert.user_id == user_id).all()
        if not db_alerts:
            # Seed default alerts based on dataset if empty
            quality_score = float(ds.quality_score) if ds.quality_score is not None else 100.0
            default_alerts = [
                BusinessAlert(
                    user_id=user_id,
                    title="Dataset Integrity Alert",
                    message=f"Dataset '{ds.name}' data quality checks identified key columns integrity validation.",
                    severity="Warning" if quality_score >= 80.0 else "Critical",
                    metric="Quality Score",
                    current_value=quality_score,
                    threshold_value=90.0,
                    is_resolved=False
                )
            ]
            db.add_all(default_alerts)
            db.commit()
            db_alerts = db.query(BusinessAlert).filter(BusinessAlert.user_id == user_id).all()

        return [
            BusinessAlertSchema(
                id=a.id,
                title=a.title,
                message=a.message,
                severity=a.severity,
                metric=a.metric,
                current_value=a.current_value,
                threshold_value=a.threshold_value,
                is_resolved=a.is_resolved,
                created_at=a.created_at
            ) for a in db_alerts
        ]

    @classmethod
    def run_executive_advisor(cls, db: Session, user_id: int, req: ExecutiveAdvisorRequest) -> Union[ExecutiveAdvisorResponse, Dict[str, Any]]:
        # Load dataset to verify upload
        ds, df = cls._get_dataset_df(db)
        if ds is None or df is None:
            return {
                "success": True,
                "data": None,
                "message": "No datasets uploaded."
            }

        # Save query to history
        db_history = DecisionHistory(
            user_id=user_id,
            action_type="advisor_query",
            query_text=req.query
        )
        db.add(db_history)
        db.commit()
        db.refresh(db_history)

        query_lower = req.query.lower()
        if "revenue" in query_lower or "sales" in query_lower:
            response_text = f"Analysis of the uploaded dataset '{ds.name}' shows steady top-line patterns. Top priority is optimizing transaction conversion rates across all product lines."
            actions = ["Optimize conversion rates", "Assess subscription tier pricing"]
            score = 85.0
        elif "cost" in query_lower or "spend" in query_lower or "profit" in query_lower:
            response_text = f"Operating net margin metrics indicate cost overheads. Review operational expenditures and consolidate vendors to protect net margins."
            actions = ["Consolidate infrastructure servers", "Audit vendor spend anomalies"]
            score = 90.0
        else:
            response_text = f"Assessment completed for dataset '{ds.name}'. Recommend continuing standard KPI tracking and evaluating custom what-if scenarios for upcoming quarters."
            actions = ["Run a volume increase what-if scenario", "Establish target metrics alerts"]
            score = 80.0

        db_history.response_text = response_text
        db.commit()

        return ExecutiveAdvisorResponse(
            response_text=response_text,
            supporting_data={"dataset_name": ds.name, "rows": len(df)},
            suggested_actions=actions,
            confidence_score=score,
            generated_at=datetime.utcnow()
        )
